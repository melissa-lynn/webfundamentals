<?xml version="1.0"?>
<exercises xml:id="html_exercises">
  <title>Exercises</title>
  <exercise>
        <p>Make a little webpage to tell me a little about yourself.  Use at least three levels of headings and some paragraphs.</p>
  <listing>
  <program xml:id="ex_html_1" interactive="activecode" language="html" label="program-activecode-html-ex-1">
    <prefix>


</prefix>
    <input>

        </input>
    <tests>
        assertExists("h1", "Checking that there is a level one heading");
        assertExists("h2", "Checking that there is a level two heading");
        assertExists("h3", "Checking that there is a level three heading");
        assertExists("p", "Checking that there is a paragraph element");
        assertValidHTML("Document has properly nested HTML tags");


</tests>
  </program>
</listing>
</exercise>
<exercise>
        <p>You can copy the URL of almost any image in a browser by right clicking on the image and choosing <q>copy image URL</q>  or something similar.  Write an html page in the activecode window for this exercise that includes a header element giving a title to some image you find,  Then include the image in the page, sized appropriately,  and a paragraph that describes the image.</p>
  <listing>
  <program xml:id="ex_html_2" interactive="activecode" language="html" label="program-activecode-html-ex-2">
    <prefix>


</prefix>
    <input>


        </input>
    <tests>
      assertExists("h1", "Checking that there is a title");
        assertExists("img", "Checking that there is an image included");
        assertExists("p", "Checking that there is a paragraph element");
        assertValidHTML("Document has properly nested HTML tags");

</tests>
  </program>
</listing>
</exercise>
<exercise>
        <p>Make an outline that has capital roman numerals at the highest level of the outline, and lower case roman numerals for the second level items.  List concepts we have covered in this class at the first level, and key points at the second level. Include at least five list items.</p>
  <listing>
  <program xml:id="ex_html_3" interactive="activecode" language="html" label="program-activecode-html-ex-3">
    <prefix>


</prefix>
    <input>


        </input>
    <tests>
      assertExists("ol", "Checking that there is an ordered list");
      assertAttribute("ol", "type", "I", "Ordered list uses capital roman numerals");
      assertCountAtLeast("ol > li", 5, "Lists contains five items");         
      assertExists("ol ol", "Checking that there is an inner ordered list");
      assertAttribute("ol ol", "type", "i", "Inner ordered list uses lower case roman numerals");
      assertValidHTML("Document has properly nested HTML tags");

</tests>
  </program>
</listing>
</exercise>
<exercise>
        <p>Use HTML to create the following table. Be sure to match text exactly.</p>
          <table>
            <title>Example Table</title>
            <tabular>
              <row header="yes">
                <cell>Tag</cell>
                <cell>Purpose</cell>
              </row>
              <row>
                <cell>p</cell>
                <cell>paragraph</cell>
              </row>
              <row>
                <cell>ol</cell>
                <cell>ordered list</cell>
              </row>
              <row>
                <cell>ul</cell>
                <cell>unordered list</cell>
              </row>
            </tabular>
          </table>
  <listing>
  <program xml:id="ex_html_4" interactive="activecode" language="html" label="program-activecode-html-ex-4">
    <prefix>


</prefix>
    <input>


        </input>
    <tests>
      assertExists("table", "Checking that there is a table");
      assertExists("table tr", "Checking that there is a table row");  <!-- implicit tbody between table and tr -->
      assertCount("table tr", 4, "Checking that the table has four rows");
      assertExists("table tr > th", "Checking that the table has headings");
      assertText("table tr > th", "Tag", "Checking that 'Tag' is a heading");
      assertText("table tr > th", "Purpose", "Checking that 'Purpose' is a heading");
      assertExists("table tr > td", "Checking that the table has entries");
      assertText("table tr > td", "p", "Checking that 'p' is an entry");
      assertText("table tr > td", "paragraph", "Checking that 'paragraph' is an entry");
      assertText("table tr > td", "ol", "Checking that 'ol' is an entry");
      assertText("table tr > td", "ordered list", "Checking that 'ordered list' is an entry");
      assertText("table tr > td", "ul", "Checking that 'ul' is an entry");
      assertText("table tr > td", "unordered list", "Checking that 'ul' is an entry");
      assertValidHTML("Document has properly nested HTML tags");

</tests>
  </program>
</listing>
</exercise>
<exercise>
        <p>Make a table that looks like this:</p>
  <blockquote>
    <image source="challengetable.png" width="50%"/>
    <p>Hint, this is going to require both rowspan and columnspan.  Also, Do not try to do this all at once.  Start with the header, then move on to the rest of the table, working in small parts</p>
  </blockquote>
  <listing>
  <program xml:id="ex_html_5" interactive="activecode" language="html" label="program-activecode-html-ex-5">
    <prefix>


</prefix>
    <input>


        </input>
    <tests>
      assertExists("table", "Checking that there is a table");
      assertExists("table tr > th", "Checking that the table has headings");
      assertText("table tr > th", "Name", "Checking that 'Name' is a heading");
      assertText("table tr > th", "Phone Numbers", "Checking that 'Phone Numbers' is a heading");
      assertAttribute("table tr > th", "colspan", "2", "Checking that colspan is used for heading");
      assertExists("table tr > td", "Checking that the table has entries");
      assertText("table tr > td", "Ole Johanssen", "Checking that 'Ole Johanssen' is an entry");
      assertAttribute("table tr > td", "rowspan", "2", "Checking that rowspan is used for entries");
      assertText("table tr > td", "Cell", "Checking that 'Cell' is an entry");
      assertText("table tr > td", "Office", "Checking that 'ol' is an entry");
      assertText("table tr > td", "555-1212", "Checking that '555-1212' is an entry");
      assertText("table tr > td", "387-1234", "Checking that '387-1234' is an entry");
      assertText("table tr > td", "Per Mertesacker", "Checking that 'Per Mertesacker' is an entry");
      assertText("table tr > td", "555-1212", "Checking that '123-5543' is an entry");
      assertText("table tr > td", "387-1234", "Checking that '382-9876' is an entry");
      assertValidHTML("Document has properly nested HTML tags");

</tests>
  </program>
</listing>
</exercise>
<exercise>
        <p>Make a webpage that links to four of your favorite websites.</p>
  <listing>
  <program xml:id="ex_html_6" interactive="activecode" language="html" label="program-activecode-html-ex-6">
    <prefix>


</prefix>
    <input>


        </input>
    <tests>
      assertExists("a", "Checking that there is a link");
      assertCount("a", "4", "Checking that there are at least four links");
      assertExists("[href]", "Checking that href is used for a link");
      assertValidHTML("Document has properly nested HTML tags");
</tests>
  </program>
</listing>
</exercise>
<exercise>
        <p>Make a webpage with a link at the bottom that when clicked will jump you all the way to the top of the page.</p>
  <listing>
  <program xml:id="ex_html_7" interactive="activecode" language="html" label="program-activecode-html-ex-7">
    <prefix>


</prefix>
    <input>


        </input>
    <tests>
      assertExists("a", "Checking that there is a link");
      assertAttribute("a", "href", "#top", "Checking that link goes to the top of the page");
      assertValidHTML("Document has properly nested HTML tags");

</tests>
  </program>
</listing>
</exercise>
<exercise>
        <p>Make a webpage with a link at the top of it that when clicked will jump all the way to the bottom of the page. At the bottom of the page there should be a link to jump back to the top of the page.</p>
  <listing>
  <program xml:id="ex_html_8" interactive="activecode" language="html" label="program-activecode-html-ex-8">
    <prefix>


</prefix>
    <input>


        </input>
    <tests>
      assertExists("a", "Checking that there is a link");
      assertAttribute("a", "href", "#top", "Checking that a link goes to the top of the page");
      assertAttribute("a", "href", "#bottom", "Checking that a link goes to the top of the page");
      assertValidHTML("Document has properly nested HTML tags");

</tests>
  </program>
</listing>
</exercise>
<exercise>
        <p>Make a webpage with an image that has a solid black border of size 2 pixels, a width of 200, and a height of 200.</p>
  <listing>
  <program xml:id="ex_html_9" interactive="activecode" language="html" label="program-activecode-html-ex-9">
    <prefix>


</prefix>
    <input>


        </input>
    <tests>
      assertExists("img", "Checking that there is an image");
      assertExists("[src]", "Checking that the image has a src");
      assertStyle("img", "border", "2px solid rgb(0, 0, 0)", "Checking that the image has border 2");
      assertStyle("img", "width", "200px", "Checking that the image has width 200");
      assertStyle("img", "height", "200px", "Checking that the image has height 200");
      assertValidHTML("Document has properly nested HTML tags");

</tests>
  </program>
</listing>
</exercise>
<exercise>
        <p>Make a webpage with five different images. Skip a line between each image. Each image should have a title.</p>
  <listing>
  <program xml:id="ex_html_10" interactive="activecode" language="html" label="program-activecode-html-ex-10">
    <prefix>


</prefix>
    <input>


        </input>
    <tests>
      assertCountAtLeast("img", 5, "Checking that there are at least 5 images");
      assertExists("br", "Checking that line breaks are used");
      assertExists("[src]", "Checking that the src attribute is used for an image");
      assertExists("[title]", "Checking that the title attribute is used for an image");
      assertValidHTML("Document has properly nested HTML tags");
</tests>
  </program>
</listing>
</exercise>
<exercise>
        <p>Make a webpage with an image that when clicked will link to a search engine of your choice</p>
  <listing>
  <program xml:id="ex_html_11" interactive="activecode" language="html" label="program-activecode-html-ex-11">
    <prefix>


</prefix>
    <input>


        </input>
    <tests>
      assertExists("img", "Checking that there is an image");
      assertExists("[src]", "Checking that the src attribute is used for an image");
      assertExists("a", "Checking that there is a link");
      assertExists("[href]", "Checking that the href attribute is used for the link");
      assertExists("a > img", "Checking that the image is used as a link");
      assertValidHTML("Document has properly nested HTML tags");

</tests>
  </program>
</listing>
</exercise>
</exercises>
